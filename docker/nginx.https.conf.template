server {
    listen 80;
    server_name astro-magister.de;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://www.astro-magister.de$request_uri;
    }
}

server {
    listen 80;
    server_name __SERVER_NAME__;

    client_max_body_size 20m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name astro-magister.de;
    ssl_certificate __SSL_CERT_PATH__;
    ssl_certificate_key __SSL_KEY_PATH__;
    return 301 https://www.astro-magister.de$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __SERVER_NAME__;

    client_max_body_size 20m;

    ssl_certificate __SSL_CERT_PATH__;
    ssl_certificate_key __SSL_KEY_PATH__;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        include /etc/nginx/includes/geoip2-api-guard.conf;
        limit_req zone=api burst=20 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /theme/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /sitemap.xml {
        proxy_pass http://api:8000/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Astro wiki index (overview page) — /astro-wiki/ → dist/index.html
    location = /astro-wiki/ {
        root /workspace/app/wiki/dist;
        try_files /index.html =500;
    }

    # Redirect /astro-wiki to /astro-wiki/
    location = /astro-wiki {
        return 301 https://$host/astro-wiki/;
    }

    # Astro wiki static pages
    location = /astro-wiki/impressum/ {
        root /workspace/app/wiki/dist;
        try_files /impressum/index.html =404;
    }
    location = /astro-wiki/datenschutz/ {
        root /workspace/app/wiki/dist;
        try_files /datenschutz/index.html =404;
    }
    location = /astro-wiki/kontakt/ {
        root /workspace/app/wiki/dist;
        try_files /kontakt/index.html =404;
    }

    # Astro wiki entries — /astro-wiki/{slug}/ → dist/wiki/{slug}/index.html
    location ~ ^/astro-wiki/([^/]+)/$ {
        root /workspace/app/wiki/dist/wiki;
        try_files /$1/index.html =404;
    }

    location /_astro {
        alias /workspace/app/wiki/dist/_astro;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /astro-wiki/_astro {
        alias /workspace/app/wiki/dist/_astro;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA (Vite dev server)
    location / {
        include /etc/nginx/includes/geoip2-api-guard.conf;
        proxy_pass http://frontend:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 429 Handler
    location @ratelimited {
        default_type application/json;
        return 429 '{"error": "Rate limit exceeded", "retry_after": 60}';
        add_header Retry-After 60 always;
    }
}