---
import Layout from '../layouts/Layout.astro'
import { DEFAULT_COVER_URL } from '../services/covers.js'

async function fetchJSON(url) {
  const res = await fetch(url)
  if (!res.ok) throw new Error(`API error ${res.status}`)
  return res.json()
}

// Quelle ist die eine Definition öffentlicher Einträge (D-13); Bereichsgrenze und
// Titelsperre liegen serverseitig. Kein `limit`, keine Nachladung von Stammdaten.
const entries = await fetchJSON('http://api:8000/wiki/build-entries')

// D-18/D-20: EINE Menge — dieselbe Bedingung wie in `[slug].astro` und in der Sitemap.
// Ein harter `section_name`-Filter würde die Seiten einer zweiten aktivierten Sektion
// bauen, aber nirgends verlinken — Sitemap-Waisen.
const buildSet = entries.filter(e => e.wiki_active === true && e.slug)

// Gruppierung nach Sektion, darunter nach Kategorie. Die Einfüge-Reihenfolge der Sektionen
// ist die Render-Reihenfolge; die Kategorienamen werden sortiert, die Einträge nach Nummer.
const sections = new Map()
for (const entry of buildSet) {
  const sectionName = entry.section_name || 'Wiki'
  const categoryName = entry.category_name || 'uncategorized'
  if (!sections.has(sectionName)) sections.set(sectionName, new Map())
  const categories = sections.get(sectionName)
  if (!categories.has(categoryName)) categories.set(categoryName, [])
  categories.get(categoryName).push(entry)
}

const byNumber = (a, b) => (a.entry_number || 0) - (b.entry_number || 0)

// D-15: die `ItemList` leitet sich aus GENAU der Reihenfolge ab, in der die Seite listet —
// nicht aus einer zweiten Sortiervorschrift, die auseinanderlaufen könnte.
const listedEntries = [...sections.values()].flatMap(categories =>
  [...categories.keys()].sort().flatMap(name => [...categories.get(name)].sort(byNumber))
)

const itemList = {
  '@type': 'ItemList',
  itemListElement: listedEntries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: entry.entry_name,
    url: new URL(`/astro-wiki/${entry.slug}/`, Astro.site).toString(),
  })),
}
---
<Layout title="Wiki Übersicht" canonicalPath="/astro-wiki/" jsonLd={[itemList]}>
  <h1>Wiki</h1>
  <p class="wiki-index-intro">Finde Erklärungen zu astrologischen Begriffen, Planeten, Aspekten und mehr.</p>
  {[...sections.keys()].map(sectionName => (
    <section class="wiki-index-section">
      <h2>{sectionName}</h2>
      {[...sections.get(sectionName).keys()].sort().map(categoryName => (
        <div class="wiki-index-group">
          <h3 class="wiki-index-category">{categoryName}</h3>
          <ul class="wiki-index-list">
            {[...sections.get(sectionName).get(categoryName)].sort(byNumber).map((entry, index) => (
              <li class="wiki-index-row">
                <div class="wiki-index-text">
                  <a class="wiki-index-title" href={`/astro-wiki/${entry.slug}/`}>{entry.entry_name}</a>
                  {entry.entry_short && <p class="wiki-index-short">{entry.entry_short}</p>}
                </div>
                <img
                  class="wiki-cover-index"
                  src={entry.cover_url || DEFAULT_COVER_URL}
                  alt=""
                  width="120"
                  height="63"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</Layout>
