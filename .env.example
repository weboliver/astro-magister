# Astronex API Configuration

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Swiss Ephemeris Settings
EPHEMERIS_PATH=~/Projects/astronex/astronex/resources
EPHEMERIS_YEAR_START=1900
EPHEMERIS_YEAR_END=2100

# Development Settings
DEBUG=true
LOG_LEVEL=info

#Perplexity API Key
API_KEY=your-perplexity-api-key-here

#Perplexity API Base URL or other
API_BASE_URL=https://api.perplexity.ai/chat/completions

# JWT / Auth settings
SECRET_KEY=replace-this-with-a-secure-random-key

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database settings (used by SQLAlchemy when DATABASE_URL is not set)
DB_HOST=localhost
DB_NAME=astronex
DB_USER=postgres
DB_PASSWORD=postgres
# Optional: full SQLAlchemy DATABASE_URL override
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost/astronex

PERPLEXITY_CACHE_MAX=10000
# PERPLEXITY_CACHE_BACKEND=redis
PERPLEXITY_CACHE_TTL=86400
# REDIS_URL=redis://redis:6379/0

TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT_ATTEMPTS=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=300
AI_RATE_LIMIT_ATTEMPTS=6
AI_RATE_LIMIT_WINDOW_SECONDS=1800
FAILED_LOGIN_LOCKOUT_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_SECONDS=3600

LETSENCRYPT_DOMAINS=yourdomain.com,www.yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
# set to 0 for production, 1 for staging
LETSENCRYPT_STAGING=1
NGINX_SERVER_NAME=yourdomain.com,www.yourdomain.com

GEOIP2_ENABLED=0
GEOIP2_ALLOWED_COUNTRIES=DE,AT,CH
GEOIP2_LICENSE_KEY=your-maxmind-license-key-here