# Astronex API Configuration

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Swiss Ephemeris Settings
EPHEMERIS_PATH=~/Projects/astronex/astronex/resources
EPHEMERIS_YEAR_START=1900
EPHEMERIS_YEAR_END=2100

# Development Settings
DEBUG=true
LOG_LEVEL=info

#Perplexity API Key
API_KEY=your-perplexity-api-key-here

#Perplexity API Base URL or other
API_BASE_URL=https://api.perplexity.ai/chat/completions

# Mistral API key — only needed when CHAT_PROVIDER=mistral; leave empty if you have no Mistral access.
MISTRAL_API_KEY=
# AI provider: perplexity (default) or mistral. A DB row app_settings.chat_provider wins over this value.
CHAT_PROVIDER=perplexity

# JWT / Auth settings
SECRET_KEY=replace-this-with-a-secure-random-key

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database settings (used by SQLAlchemy when DATABASE_URL is not set)
DB_HOST=localhost
DB_NAME=astronex
DB_USER=postgres
DB_PASSWORD=postgres
# Optional: full SQLAlchemy DATABASE_URL override
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost/astronex

PERPLEXITY_CACHE_MAX=10000
# PERPLEXITY_CACHE_BACKEND=redis
PERPLEXITY_CACHE_TTL=86400
# REDIS_URL=redis://redis:6379/0

TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT_ATTEMPTS=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=300
AI_RATE_LIMIT_ATTEMPTS=6
AI_RATE_LIMIT_WINDOW_SECONDS=1800
FAILED_LOGIN_LOCKOUT_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_SECONDS=3600

# TRUSTED_PROXIES=172.28.0.15 — reverse proxies allowed to set X-Real-IP (nginx container in the compose network).
# Wird automatisch aus NETWORK_IP_PREFIX abgeleitet (<NETWORK_IP_PREFIX>.15); nur setzen, wenn abweichend gewünscht.

# Docker network (docker/docker-compose.yml)
# Wenn das Default-Subnetz auf dem Host schon belegt ist (z. B. durch ein anderes
# Compose-Projekt), hier ein freies Netz eintragen und den Stack neu erstellen.
# NETWORK_SUBNET bestimmt das Subnetz; NETWORK_IP_PREFIX (erste drei Oktette davon)
# die statischen Container-IPs .10–.15 und kann bei Bedarf leer bleiben — dann wird
# er von docker/build.sh, docker/start.sh und docker/update.sh automatisch abgeleitet.
NETWORK_NAME=astronex_internal
NETWORK_SUBNET=172.28.0.0/16
# NETWORK_IP_PREFIX=172.28.0

# E2E Testing support
# BYPASS_CAPTCHA=true — bypass Turnstile captcha validation (for Playwright tests)
BYPASS_CAPTCHA=false
# SEED_E2E_USER=1 — create e2e-test-user poweruser account on startup
SEED_E2E_USER=0

LETSENCRYPT_DOMAINS=yourdomain.com,www.yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
# set to 0 for production, 1 for staging
LETSENCRYPT_STAGING=1
NGINX_SERVER_NAME=yourdomain.com,www.yourdomain.com

# Kanonischer Produktions-Redirect (Apex -> www). Wirkt nur bei DEBUG=false;
# mit DEBUG=true rendert der nginx-Entrypoint die Redirect-Blöcke nicht, damit
# lokale Hosts (z. B. astro-magister.local) direkt bedient werden.
# NGINX_CANONICAL_SOURCES=yourdomain.com
# NGINX_CANONICAL_HOST=www.yourdomain.com

# Lokales HTTPS im Entwicklungsmodus (DEBUG=true) mit mkcert-Zertifikaten.
# Zertifikate einmalig auf dem Host erzeugen (docker/certs wird als
# /etc/nginx/dev-certs in den nginx-Container gemountet):
#   mkdir -p docker/certs
#   mkcert -key-file docker/certs/astro-magister.local-key.pem \
#          -cert-file docker/certs/astro-magister.local.pem \
#          astro-magister.local localhost 127.0.0.1 ::1
# Fehlen die Dateien, startet nginx im Debug-Modus nur mit HTTP.
DEV_HTTPS_HOSTS=astro-magister.local localhost
DEV_SSL_CERT_PATH=/etc/nginx/dev-certs/astro-magister.local.pem
DEV_SSL_KEY_PATH=/etc/nginx/dev-certs/astro-magister.local-key.pem

# Hosts, die der Vite-Dev-Server akzeptiert (sonst 403 "Blocked request").
# VITE_ALLOWED_HOSTS=localhost,127.0.0.1,astro-magister.local
# Basis-URL des Frontends — muss zum Schema passen, das nginx tatsächlich ausliefert
# (http ohne mkcert-Zertifikate, https mit).
# BASE_URL=https://astro-magister.local
